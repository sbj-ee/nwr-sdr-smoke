# Copy to config/phase2.env (gitignored). No cloud API keys — local STT only.
# Spec: docs/PHASE2.md. Do not enable until Phase 1 SAME FP rate is acceptable.

# Primary engine: whisper_cpp | (fallback later) vosk | faster_whisper
STT_ENGINE=whisper_cpp
STT_MODEL=base.en

# Paths (Protectli checkout-relative defaults; override for /var/lib/nwr-alerts)
# Must match Phase 1 DATA_DIR when updating the same alerts.db
DATA_DIR=data
STT_MODEL_PATH=data/models/ggml-base.en.bin
# Built per docs/PHASE2.md "Dependencies": git clone + cmake build under ~/NOAA/whisper.cpp
WHISPER_CPP_BIN=/home/stevebj/NOAA/whisper.cpp/build/bin/whisper-cli

# 0 = disabled (Phase 1 only). 1 = phase2/worker.py polls for pending transcripts.
STT_ENABLED=0

# Optional: threads / language
# STT_THREADS=4
# STT_LANGUAGE=en

# Decoding effort — whisper.cpp's own defaults. Tried forcing greedy (1/1)
# on Protectli's Celeron N5105 to save time; it wasn't meaningfully faster
# (the encoder pass dominates wall time, not beam search) and quality was
# visibly worse (dropped a county-name read-out as "[static]"). Lower
# only if a real clip proves too slow.
STT_BEAM_SIZE=5
STT_BEST_OF=5

# How often the poller checks for new pending rows, and how many it
# transcribes per pass.
STT_POLL_INTERVAL_S=15
STT_POLL_LIMIT=5
