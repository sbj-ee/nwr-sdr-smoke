# Copy to config/phase2.env (gitignored). No cloud API keys — local STT only.
# Spec: docs/PHASE2.md. Do not enable until Phase 1 SAME FP rate is acceptable.

# Primary engine: whisper_cpp | (fallback later) vosk | faster_whisper
STT_ENGINE=whisper_cpp
STT_MODEL=base.en

# Paths (Protectli checkout-relative defaults; override for /var/lib/nwr-alerts)
# Must match Phase 1 DATA_DIR when updating the same alerts.db
DATA_DIR=data
STT_MODEL_PATH=data/models/ggml-base.en.bin
# WHISPER_CPP_BIN=/usr/local/bin/whisper-cli

# 0 = disabled (Phase 1 only). 1 = enqueue STT after clip close (once implemented)
STT_ENABLED=0

# Optional: threads / language
# STT_THREADS=4
# STT_LANGUAGE=en
