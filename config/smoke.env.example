# Copy to config/smoke.env and edit. smoke.env is gitignored.

# WXJ-87 Madison (NWR channel 7). Alternates: 162425000 (WWG-90), 162450000 (KHA-47).
FREQ_HZ=162550000

# rtl_fm index, or a serial string once you have more than one stick on this host.
DEVICE_INDEX=0

# Seconds of audio to capture. 20 is enough to prove carrier; 60 is better by ear.
DURATION_S=20

# rtl_fm gain (0 = auto). Start with auto; raise if RMS is weak.
GAIN=0

# PPM crystal correction if you know it for this stick; 0 if unknown.
PPM=0

# Audio sample rate for rtl_fm / sox (design brief Phase 0 sketch).
SAMPLE_RATE=22050

# Fail the smoke test if WAV RMS is below this (dBFS). Live NWR is usually much louder.
MIN_RMS_DBFS=-50

# Fail if peak is below this (dBFS). Catches near-total silence.
MIN_PEAK_DBFS=-25
