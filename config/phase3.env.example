# Copy to config/phase3.env (gitignored). Spec: docs/PHASE3.md.
# Do not commit tokens. MVP notify = ts-notify-hub over Tailscale (no cloud webhook SaaS).

# 0 = disabled (worker should exit clean). 1 = poll and publish.
NOTIFY_ENABLED=0

# Same DB/audio root as Phase 1/2
DATA_DIR=data

# ts-notify-hub (debian199, Tailscale-only)
NOTIFY_HUB_URL=http://debian199.tailade1d3.ts.net:8787
# Publish-scoped bearer — mint on hub; never commit
NOTIFY_TOKEN=
NOTIFY_TOPIC=house-nwr
# Second topic for warning-class; leave empty to disable dual-publish
NOTIFY_URGENT_TOPIC=house-urgent

# warning | watch | advisory | all  (design default: warning)
NOTIFY_MIN_CLASS=warning
# 1 = also notify RWT/RMT/NPT/DMO / event_class=test
NOTIFY_TESTS=0
# 1 = notify unknown SAME codes (event_class=other)
NOTIFY_UNKNOWN=0

# 1 = log JSON only, no HTTP
NOTIFY_DRY_RUN=0

# Optional digest (hourly summary); immediate ≥ warning still on unless NOTIFY_IMMEDIATE=0
NOTIFY_DIGEST=0
NOTIFY_DIGEST_INTERVAL_S=3600
NOTIFY_IMMEDIATE=1

NOTIFY_POLL_INTERVAL_S=15
NOTIFY_POLL_LIMIT=20

# Optional Slack secondary (not required for MVP)
# SLACK_WEBHOOK_URL=
# SLACK_ENABLED=0
