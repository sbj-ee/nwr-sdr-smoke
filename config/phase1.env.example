# Copy to config/phase1.env (gitignored). No secrets required for Phase 1.

# WXJ-87 Madison
FREQ_HZ=162550000
DEVICE_INDEX=0
SAMPLE_RATE=22050
GAIN=0
PPM=0

# 1 = prefix rtl_fm with sudo -n (until udev/plugdev works)
USE_SUDO_RTL=0

# Storage (Protectli checkout-relative default; override for /var/lib/nwr-alerts)
DATA_DIR=data

# Seconds of audio kept before SAME header for the clip
PRE_ROLL_S=3
# Max clip length if NNNN never arrives
MAX_CLIP_S=600

# Dane County; empty = store every county on this transmitter
REQUIRE_COUNTY_FIPS=055025

# Store RWT/RMT/etc (design: store tests; notify suppress is Phase 3)
STORE_TESTS=1

# Ubuntu multimon-ng 1.3.0 uses EAS (not SAME). Leave blank to auto-detect.
# MULTIMON_DEMOD=EAS
