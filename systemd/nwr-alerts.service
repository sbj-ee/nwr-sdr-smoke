# Optional *system* unit (runs as User=). Prefer the user unit in
# systemd/user/nwr-alerts.service + scripts/install_systemd_user.sh.
[Unit]
Description=NWR SAME alert listener (Phase 1)
Documentation=https://github.com/sbj-ee/nwr-sdr-smoke
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stevebj
Group=stevebj
WorkingDirectory=/home/stevebj/NOAA/nwr-sdr-smoke
EnvironmentFile=-/home/stevebj/NOAA/nwr-sdr-smoke/config/phase1.env
ExecStart=/usr/bin/python3 /home/stevebj/NOAA/nwr-sdr-smoke/phase1/listen.py
Restart=on-failure
RestartSec=5
ExecStartPre=/bin/sleep 3

[Install]
WantedBy=multi-user.target
